# Server Configuration
PORT=3000
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://pelayo_user:pelayo_secret@localhost:5432/pelayodb?schema=public

# WhatsApp Cloud API (Sprint 2)
# Token secreto configurado en el panel de Meta para la verificación GET del webhook
WHATSAPP_VERIFY_TOKEN=local_dev_verify_token_change_in_production
# App Secret de la aplicación en Meta for Developers para validar la firma HMAC-SHA256 (x-hub-signature-256)
WHATSAPP_APP_SECRET=your_meta_app_secret_here
# Token de acceso Bearer permanente o temporal generado en Meta for Developers
WHATSAPP_API_TOKEN=your_meta_access_token_here
# ID del número de teléfono remitente en WhatsApp Cloud API (Phone Number ID)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# ID de la cuenta comercial de WhatsApp (WABA ID - opcional)
WHATSAPP_BUSINESS_ACCOUNT_ID=
# URL base de la Graph API de Meta
WHATSAPP_API_URL=https://graph.facebook.com/v21.0

