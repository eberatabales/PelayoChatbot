{
  "name": "pelayobot",
  "version": "0.1.0",
  "description": "Sistema de atencion automatizada por WhatsApp para Automoviles Pelayo",
  "author": "Automoviles Pelayo",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "db:test:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-test-db.ps1",
    "db:test:start": "powershell -NoProfile -Command \"& \\\"$env:LOCALAPPDATA\\Programs\\pgsql\\bin\\pg_ctl.exe\\\" -D \\\"$env:LOCALAPPDATA\\Programs\\pgsql\\data_test\\\" -l \\\"$env:LOCALAPPDATA\\Programs\\pgsql\\postgres_test.log\\\" -o '-p 5433' start\"",
    "db:test:stop": "powershell -NoProfile -Command \"& \\\"$env:LOCALAPPDATA\\Programs\\pgsql\\bin\\pg_ctl.exe\\\" -D \\\"$env:LOCALAPPDATA\\Programs\\pgsql\\data_test\\\" stop -m fast\"",
    "start:test": "powershell -NoProfile -Command \"$env:DATABASE_URL='postgresql://test_user:test_secret_isolated_pw@localhost:5433/pelayodb_test?schema=public'; $env:PORT='3001'; node dist/main.js\"",
    "test:verify:native": "node scripts/verify-s1-native.js",
    "test:verify:s2": "node scripts/verify-s2-native.js",
    "test:whatsapp:live": "node scripts/demo-live-whatsapp.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^6.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.24",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "prisma": "^6.4.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!**/main.ts",
      "!**/*.module.ts"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
